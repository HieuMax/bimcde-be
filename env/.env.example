# # bimcde-be\env\.env.example

# --- SERVER CONFIG ---
APP_PORT=4000
APP_URL=http://localhost:4000/api
APP_TITLE="BIM CDE"
NODE_ENV=development

# --- CLIENT CONFIG (FRONTEND) ---
# Đây là link dùng để tạo đường dẫn share
CLIENT_URL=http://localhost:3000

# --- DATABASE ---
MONGODB_URL=mongodb://localhost:27017/bimcde

# --- MAIL CONFIG ---
MAIL_USER=anhhao24062004@gmail.com
# Đổi tên cho chuẩn, dùng App Password 16 ký tự
MAIL_PASS=frbdxatcvwpbqbpu

# --- JWT & SECURITY ---
JWT_ACESS_TOKEN_SECRET=secret_access_key_here
JWT_REFRESH_TOKEN_SECRET=secret_refresh_key_here
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
WHITE_LISTED_DOMAINS=["http://localhost:3000"]

# --- SWAGGER ---
SWAGGER_VERSION=1.0
SWAGGER_PATH=/api/docs

# --- STORAGE (R2) ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=